<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PrintOrder" targetNamespace="https://example.invalid/print-process" exporter="CopilotProcessKit" exporterVersion="1.0">
  <bpmn:process id="Process_PrintOrder" name="Print order lifecycle" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Internal">
      <bpmn:lane id="Lane_Sales" name="Sales">
        <bpmn:flowNodeRef>Start_OrderReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviseOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_Cancel</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Prepress" name="Prepress">
        <bpmn:flowNodeRef>Task_Preflight</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestChanges</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReleaseArtwork</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="Approver">
        <bpmn:flowNodeRef>Task_InternalApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_ApprovalTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ApprovalOutcome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Production" name="Production">
        <bpmn:flowNodeRef>Task_PrintFinish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_QualityCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_QualityPass</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CloseOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Automation" name="Automation">
        <bpmn:flowNodeRef>Task_RequestApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordExpiry</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_Received</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_RecordOrder" name="Record order / Submit">
      <bpmn:incoming>Flow_Received</bpmn:incoming>
      <bpmn:outgoing>Flow_Recorded</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Preflight" name="Preflight + consent check">
      <bpmn:incoming>Flow_Recorded</bpmn:incoming>
      <bpmn:outgoing>Flow_Preflight</bpmn:outgoing>
      <bpmn:incoming>Flow_Resubmitted</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_OrderValid" name="Order valid?" default="Flow_Invalid">
      <bpmn:incoming>Flow_Preflight</bpmn:incoming>
      <bpmn:outgoing>Flow_Invalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RequestChanges" name="Request changes">
      <bpmn:incoming>Flow_Invalid</bpmn:incoming>
      <bpmn:outgoing>Flow_ChangeRequested</bpmn:outgoing>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ReviseOrder" name="Revise / Resubmit">
      <bpmn:incoming>Flow_ChangeRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_Resubmitted</bpmn:outgoing>
      <bpmn:incoming>Flow_ExpiredCorrection</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_RequestApproval" name="Validate: freeze snapshot; request approval">
      <bpmn:incoming>Flow_Valid</bpmn:incoming>
      <bpmn:outgoing>Flow_ApprovalRequested</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_InternalApproval" name="Internal approval (exact snapshot)">
      <bpmn:incoming>Flow_ApprovalRequested</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_ApprovalTimeout" name="72h" attachedToRef="Task_InternalApproval" cancelActivity="true">
      <bpmn:timerEventDefinition id="Timer_Approval72h">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT72H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
      <bpmn:outgoing>Flow_Timeout</bpmn:outgoing>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_ApprovalOutcome" name="Approved?" default="Flow_Rejected">
      <bpmn:incoming>Flow_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RecordExpiry" name="Record expiry / ApprovalExpired">
      <bpmn:incoming>Flow_Timeout</bpmn:incoming>
      <bpmn:outgoing>Flow_ExpiredCorrection</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ReleaseArtwork" name="Release approved snapshot">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Released</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PrintFinish" name="StartProduction; print + finish">
      <bpmn:incoming>Flow_Released</bpmn:incoming>
      <bpmn:outgoing>Flow_Printed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_QualityCheck" name="Manual quality check">
      <bpmn:incoming>Flow_Printed</bpmn:incoming>
      <bpmn:outgoing>Flow_Checked</bpmn:outgoing>
      <bpmn:incoming>Flow_Reworked</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_QualityPass" name="QC passed?" default="Flow_QCFailed">
      <bpmn:incoming>Flow_Checked</bpmn:incoming>
      <bpmn:outgoing>Flow_QCPassed</bpmn:outgoing>
      <bpmn:outgoing>Flow_QCFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Rework" name="Production rework">
      <bpmn:incoming>Flow_QCFailed</bpmn:incoming>
      <bpmn:outgoing>Flow_Reworked</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CloseOrder" name="Complete with QC reference + waste">
      <bpmn:incoming>Flow_QCPassed</bpmn:incoming>
      <bpmn:outgoing>Flow_Closed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Completed" name="Completed">
      <bpmn:incoming>Flow_Closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Received" sourceRef="Start_OrderReceived" targetRef="Task_RecordOrder" />
    <bpmn:sequenceFlow id="Flow_Recorded" sourceRef="Task_RecordOrder" targetRef="Task_Preflight" />
    <bpmn:sequenceFlow id="Flow_Preflight" sourceRef="Task_Preflight" targetRef="Gateway_OrderValid" />
    <bpmn:sequenceFlow id="Flow_Invalid" sourceRef="Gateway_OrderValid" targetRef="Task_RequestChanges" name="No" />
    <bpmn:sequenceFlow id="Flow_ChangeRequested" sourceRef="Task_RequestChanges" targetRef="Task_ReviseOrder" />
    <bpmn:sequenceFlow id="Flow_Resubmitted" sourceRef="Task_ReviseOrder" targetRef="Task_Preflight" />
    <bpmn:sequenceFlow id="Flow_Valid" sourceRef="Gateway_OrderValid" targetRef="Task_RequestApproval" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Preflight passed; customer consent and draft verified</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ApprovalRequested" sourceRef="Task_RequestApproval" targetRef="Task_InternalApproval" />
    <bpmn:sequenceFlow id="Flow_Decision" sourceRef="Task_InternalApproval" targetRef="Gateway_ApprovalOutcome" />
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Gateway_ApprovalOutcome" targetRef="Task_RequestChanges" name="Reject" />
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gateway_ApprovalOutcome" targetRef="Task_ReleaseArtwork" name="Approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Valid matching timely approval</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Timeout" sourceRef="Boundary_ApprovalTimeout" targetRef="Task_RecordExpiry" name="Deadline reached" />
    <bpmn:sequenceFlow id="Flow_ExpiredCorrection" sourceRef="Task_RecordExpiry" targetRef="Task_ReviseOrder" />
    <bpmn:sequenceFlow id="Flow_Released" sourceRef="Task_ReleaseArtwork" targetRef="Task_PrintFinish" />
    <bpmn:sequenceFlow id="Flow_Printed" sourceRef="Task_PrintFinish" targetRef="Task_QualityCheck" />
    <bpmn:sequenceFlow id="Flow_Checked" sourceRef="Task_QualityCheck" targetRef="Gateway_QualityPass" />
    <bpmn:sequenceFlow id="Flow_QCPassed" sourceRef="Gateway_QualityPass" targetRef="Task_CloseOrder" name="Yes">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Manual QC passed</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_QCFailed" sourceRef="Gateway_QualityPass" targetRef="Task_Rework" name="No" />
    <bpmn:sequenceFlow id="Flow_Reworked" sourceRef="Task_Rework" targetRef="Task_QualityCheck" />
    <bpmn:sequenceFlow id="Flow_Closed" sourceRef="Task_CloseOrder" targetRef="End_Completed" />
    <bpmn:subProcess id="SubProcess_Cancel" name="Preproduction cancellation exception" triggeredByEvent="true">
      <bpmn:startEvent id="Start_Cancel" name="Authorized Cancel" isInterrupting="true">
        <bpmn:conditionalEventDefinition id="Condition_Cancel">
          <bpmn:condition xsi:type="bpmn:tFormalExpression">Authorized Sales or Owner Cancel with reason AND Status in Submitted, ChangesRequested, ApprovalExpired, Approved, ReadyForProduction</bpmn:condition>
        </bpmn:conditionalEventDefinition>
        <bpmn:outgoing>Flow_CancelRecord</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_RecordCancellation" name="Record Cancelled + reason">
        <bpmn:incoming>Flow_CancelRecord</bpmn:incoming>
        <bpmn:outgoing>Flow_CancelEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Cancelled" name="Cancelled">
        <bpmn:incoming>Flow_CancelEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_CancelRecord" sourceRef="Start_Cancel" targetRef="Task_RecordCancellation" />
      <bpmn:sequenceFlow id="Flow_CancelEnd" sourceRef="Task_RecordCancellation" targetRef="End_Cancelled" />
    </bpmn:subProcess>
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_PrintOrder">
    <bpmn:participant id="Participant_Shop" name="Internal print shop" processRef="Process_PrintOrder" />
    <bpmn:participant id="Participant_Customer" name="Customer (external)" />
    <bpmn:messageFlow id="Message_Order" name="Order request" sourceRef="Participant_Customer" targetRef="Start_OrderReceived" />
    <bpmn:messageFlow id="Message_Corrections" name="Sales coordinates corrections / consent" sourceRef="Task_ReviseOrder" targetRef="Participant_Customer" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_PrintOrder">
    <bpmndi:BPMNPlane id="Plane_PrintOrder" bpmnElement="Collaboration_PrintOrder">
      <bpmndi:BPMNShape id="Shape_Participant_Customer" bpmnElement="Participant_Customer">
        <dc:Bounds x="70" y="40" width="3170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Shop" bpmnElement="Participant_Shop" isHorizontal="true">
        <dc:Bounds x="30" y="170" width="3210" height="1000" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Sales" bpmnElement="Lane_Sales" isHorizontal="true">
        <dc:Bounds x="60" y="170" width="3180" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Prepress" bpmnElement="Lane_Prepress" isHorizontal="true">
        <dc:Bounds x="60" y="370" width="3180" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Approver" bpmnElement="Lane_Approver" isHorizontal="true">
        <dc:Bounds x="60" y="570" width="3180" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Production" bpmnElement="Lane_Production" isHorizontal="true">
        <dc:Bounds x="60" y="770" width="3180" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Automation" bpmnElement="Lane_Automation" isHorizontal="true">
        <dc:Bounds x="60" y="970" width="3180" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_OrderReceived" bpmnElement="Start_OrderReceived">
        <dc:Bounds x="110" y="235" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="65" y="276" width="140" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RecordOrder" bpmnElement="Task_RecordOrder">
        <dc:Bounds x="200" y="210" width="150" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Preflight" bpmnElement="Task_Preflight">
        <dc:Bounds x="400" y="410" width="150" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_OrderValid" bpmnElement="Gateway_OrderValid">
        <dc:Bounds x="620" y="425" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="480" width="140" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RequestChanges" bpmnElement="Task_RequestChanges">
        <dc:Bounds x="760" y="410" width="150" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReviseOrder" bpmnElement="Task_ReviseOrder">
        <dc:Bounds x="960" y="210" width="150" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RequestApproval" bpmnElement="Task_RequestApproval">
        <dc:Bounds x="1140" y="1010" width="170" height="95" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_InternalApproval" bpmnElement="Task_InternalApproval">
        <dc:Bounds x="1400" y="610" width="170" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_ApprovalTimeout" bpmnElement="Boundary_ApprovalTimeout">
        <dc:Bounds x="1530" y="677" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_ApprovalOutcome" bpmnElement="Gateway_ApprovalOutcome">
        <dc:Bounds x="1690" y="625" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1645" y="680" width="140" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RecordExpiry" bpmnElement="Task_RecordExpiry">
        <dc:Bounds x="1630" y="1010" width="170" height="95" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_ReleaseArtwork" bpmnElement="Task_ReleaseArtwork">
        <dc:Bounds x="1840" y="410" width="170" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_PrintFinish" bpmnElement="Task_PrintFinish">
        <dc:Bounds x="2090" y="810" width="170" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_QualityCheck" bpmnElement="Task_QualityCheck">
        <dc:Bounds x="2370" y="810" width="150" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_QualityPass" bpmnElement="Gateway_QualityPass">
        <dc:Bounds x="2630" y="825" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2585" y="790" width="140" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Rework" bpmnElement="Task_Rework">
        <dc:Bounds x="2580" y="905" width="150" height="55" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CloseOrder" bpmnElement="Task_CloseOrder">
        <dc:Bounds x="2820" y="810" width="180" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Completed" bpmnElement="End_Completed">
        <dc:Bounds x="3100" y="835" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3055" y="876" width="140" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SubProcess_Cancel" bpmnElement="SubProcess_Cancel" isExpanded="true">
        <dc:Bounds x="2180" y="195" width="1000" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Cancel" bpmnElement="Start_Cancel">
        <dc:Bounds x="2210" y="248" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_RecordCancellation" bpmnElement="Task_RecordCancellation">
        <dc:Bounds x="2350" y="230" width="190" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Cancelled" bpmnElement="End_Cancelled">
        <dc:Bounds x="2650" y="248" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_Received" bpmnElement="Flow_Received">
        <di:waypoint x="146" y="253" />
        <di:waypoint x="200" y="253" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Recorded" bpmnElement="Flow_Recorded">
        <di:waypoint x="350" y="253" />
        <di:waypoint x="375" y="253" />
        <di:waypoint x="375" y="453" />
        <di:waypoint x="400" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Preflight" bpmnElement="Flow_Preflight">
        <di:waypoint x="550" y="453" />
        <di:waypoint x="620" y="450" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Invalid" bpmnElement="Flow_Invalid">
        <di:waypoint x="670" y="450" />
        <di:waypoint x="760" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ChangeRequested" bpmnElement="Flow_ChangeRequested">
        <di:waypoint x="910" y="453" />
        <di:waypoint x="935" y="453" />
        <di:waypoint x="935" y="253" />
        <di:waypoint x="960" y="253" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Resubmitted" bpmnElement="Flow_Resubmitted">
        <di:waypoint x="1035" y="210" />
        <di:waypoint x="1035" y="190" />
        <di:waypoint x="475" y="190" />
        <di:waypoint x="475" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Valid" bpmnElement="Flow_Valid">
        <di:waypoint x="645" y="475" />
        <di:waypoint x="645" y="1058" />
        <di:waypoint x="1140" y="1058" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ApprovalRequested" bpmnElement="Flow_ApprovalRequested">
        <di:waypoint x="1310" y="1058" />
        <di:waypoint x="1350" y="1058" />
        <di:waypoint x="1350" y="653" />
        <di:waypoint x="1400" y="653" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Decision" bpmnElement="Flow_Decision">
        <di:waypoint x="1570" y="653" />
        <di:waypoint x="1690" y="650" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Rejected" bpmnElement="Flow_Rejected">
        <di:waypoint x="1715" y="625" />
        <di:waypoint x="1715" y="530" />
        <di:waypoint x="835" y="530" />
        <di:waypoint x="835" y="495" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Approved" bpmnElement="Flow_Approved">
        <di:waypoint x="1740" y="650" />
        <di:waypoint x="1795" y="650" />
        <di:waypoint x="1795" y="453" />
        <di:waypoint x="1840" y="453" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Timeout" bpmnElement="Flow_Timeout">
        <di:waypoint x="1548" y="713" />
        <di:waypoint x="1548" y="1058" />
        <di:waypoint x="1630" y="1058" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ExpiredCorrection" bpmnElement="Flow_ExpiredCorrection">
        <di:waypoint x="1715" y="1105" />
        <di:waypoint x="1715" y="1140" />
        <di:waypoint x="1120" y="1140" />
        <di:waypoint x="1120" y="253" />
        <di:waypoint x="1110" y="253" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Released" bpmnElement="Flow_Released">
        <di:waypoint x="2010" y="453" />
        <di:waypoint x="2050" y="453" />
        <di:waypoint x="2050" y="853" />
        <di:waypoint x="2090" y="853" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Printed" bpmnElement="Flow_Printed">
        <di:waypoint x="2260" y="853" />
        <di:waypoint x="2370" y="853" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Checked" bpmnElement="Flow_Checked">
        <di:waypoint x="2520" y="853" />
        <di:waypoint x="2630" y="850" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_QCPassed" bpmnElement="Flow_QCPassed">
        <di:waypoint x="2680" y="850" />
        <di:waypoint x="2820" y="853" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_QCFailed" bpmnElement="Flow_QCFailed">
