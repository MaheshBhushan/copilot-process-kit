      "Exceptions": "Status IN ChangesRequested, ApprovalExpired",
      "Completed": "Status = Completed"
    },
    "OrderCommands": {
      "Pending": "ProcessingState = Pending",
      "NeedsReview": "ProcessingState = NeedsReview"
    },
